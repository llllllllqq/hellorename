# 本地签名配置示例
#
# 用法：
#   1. 复制本文件为仓库根目录的 keystore.properties
#   2. 填入你自己的密钥库路径与口令（该文件已被 .gitignore 忽略，不会上传）
#   3. 本地执行 ./gradlew assembleRelease 就会用它签名
#
# GitHub Actions 云编译不读这个文件，而是用仓库 Secrets：
#   SIGNING_KEYSTORE_BASE64 / SIGNING_STORE_PASSWORD / SIGNING_KEY_ALIAS / SIGNING_KEY_PASSWORD
#
# 两项都没有配置时，release 会退回使用 debug 签名（仅适合自测，不适合分发）。

storeFile=/absolute/path/to/hellorename-release.jks
storePassword=CHANGE_ME
keyAlias=hellorename
keyPassword=CHANGE_ME
