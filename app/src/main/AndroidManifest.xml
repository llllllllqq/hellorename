<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        本应用不需要任何权限：
        接收文件走系统分享(URI 授权)，重新分享走自己的 FileProvider。
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hellorename">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">

            <!--
                从启动器打开（手动选择文件）。SaveCopy 没有这条入口，
                但 beta 要能手动打开做对照，所以保留；它不参与“打开/分享”的候选匹配。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                SEND / SEND_MULTIPLE：beta.2 起与 SaveCopy 完全一致——
                两个 action 装在同一个 filter 里，只声明 7 类 MIME，而且不带 scheme。
                正式版那两条 */* filter 已删除（*/* 比这 7 类宽，但不排除 OEM 解析器
                用自己的一套规则做候选过滤）；分享请求通常没有 data URI，带 scheme 会直接不匹配。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="font/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="model/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!--
                “打开方式”入口：beta 分支的对照组，形状与 SaveCopy 完全一致。
                7 类 MIME 各自显式带 content scheme，全部装在一个 intent-filter 里。
                与正式版的三条 filter 相比，这里有意少了两件事：
                  - 没有 */*（不再匹配 message/*、multipart/* 等其余类型族）；
                  - 没有“只声明 content scheme”的兜底（MIME 为 null 的请求接不住）。
                file: 也不在匹配范围内。这三点正是本轮要验证的变量，
                实验结束前不要顺手补回来，否则对照组就失去意义。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:mimeType="application/*"
                    android:scheme="content" />
                <data
                    android:mimeType="audio/*"
                    android:scheme="content" />
                <data
                    android:mimeType="font/*"
                    android:scheme="content" />
                <data
                    android:mimeType="image/*"
                    android:scheme="content" />
                <data
                    android:mimeType="model/*"
                    android:scheme="content" />
                <data
                    android:mimeType="text/*"
                    android:scheme="content" />
                <data
                    android:mimeType="video/*"
                    android:scheme="content" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
